# Optional Firebase Web configuration overrides for local development.
# Chater's Firebase project configuration is already included in src/lib/firebase.ts.
# Leave these blank to use the project's built-in configuration.
# Never put service-account private keys or Admin SDK credentials in frontend variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
