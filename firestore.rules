rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /usernames/{username} {
      // Usernames are public identifiers; reads support availability checks.
      allow read: if true;
      // A username can be created once and belongs to its owner.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /moments/{momentId} {
      // Signed-in members can view Moments while the client hides expired entries.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'mediaUrl', 'mediaType', 'caption', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'mediaUrl', 'mediaType', 'caption', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 180
        && (request.resource.data.expiresAt is int
          || request.resource.data.expiresAt is float);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      // Signed-in members can read profiles. Only the matching account owner
      // can create, update, or delete this user's profile document.
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
