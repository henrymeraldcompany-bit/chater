rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBlocked(blockingUid, targetUid) {
      return exists(/databases/$(database)/documents/users/$(blockingUid)/blocked/$(targetUid));
    }

    function canMessage(firstUid, secondUid) {
      return !isBlocked(firstUid, secondUid) && !isBlocked(secondUid, firstUid);
    }

    match /usernames/{username} {
      // Usernames are public identifiers; reads support availability checks.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /moments/{momentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'mediaUrl', 'mediaType', 'caption', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'mediaUrl', 'mediaType', 'caption', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video', 'audio']
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 180
        && (request.resource.data.expiresAt is int
          || request.resource.data.expiresAt is float);
      allow update: if false;
      allow delete: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || (
            (resource.data.expiresAt is int || resource.data.expiresAt is float)
            && resource.data.expiresAt <= request.time.toMillis()
          )
        );
    }

    match /users/{userId} {
      // Signed-in members can read profiles. Only the matching account owner
      // can create, update, or delete this user's profile document.
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid == userId;

      // The owner alone can read and manage their private Chater contact list.
      match /contacts/{contactUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && contactUid != userId
          && request.resource.data.keys().hasOnly(['uid', 'addedAt'])
          && request.resource.data.uid == contactUid
          && request.resource.data.addedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // Per-account, per-conversation wallpaper and theme preferences.
      // Only the owner can read or change their own chat appearance settings.
      match /chatPreferences/{conversationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['theme', 'imageUrl', 'updatedAt'])
          && request.resource.data.keys().hasAll(['theme', 'imageUrl', 'updatedAt'])
          && request.resource.data.theme in ['default', 'midnight', 'forest', 'rose', 'custom']
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 2048
          && (request.resource.data.theme != 'custom' || request.resource.data.imageUrl.size() > 0)
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // A block is private to the account that placed it.
      match /blocked/{blockedUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedUid != userId
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == blockedUid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(blockedUid));
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // Reports can be submitted by signed-in members. Report records are private:
    // this client can create them but cannot read, update, or delete them.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'reportedUid', 'conversationId', 'reason', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'reporterUid', 'reportedUid', 'conversationId', 'reason', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedUid))
        && request.resource.data.conversationId is string
        && request.resource.data.reason in [
          'spam', 'harassment', 'impersonation', 'inappropriate', 'other'
        ]
        && request.resource.data.createdAt == request.time;
    }

    // One deterministic two-member conversation is shared by both accounts.
    // Either member can start it directly; no request/acceptance state exists.
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt'
        ])
        && request.resource.data.keys().hasAll([
          'participants', 'createdAt', 'updatedAt',
          'lastMessageText', 'lastMessageSenderId', 'lastMessageAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && canMessage(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 180;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt'
        ])
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() <= 180
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time
        && canMessage(
          request.auth.uid,
          resource.data.participants[0] == request.auth.uid
            ? resource.data.participants[1]
            : resource.data.participants[0]
        );

      // Account deletion may remove a member's conversations and their messages.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function conversationAfterWrite() {
          return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'recipientId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId is string
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && request.auth.uid in conversationAfterWrite().participants
          && request.resource.data.recipientId in conversationAfterWrite().participants
          && conversationAfterWrite().participants.size() == 2
          && canMessage(request.auth.uid, request.resource.data.recipientId);

        allow update: if false;
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Group chats: membership controls group discovery and all conversation access.
    match /groups/{groupId} {
      function isGroupMember() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      function isGroupAdmin() {
        return isGroupMember()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.adminIds;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'photoURL', 'ownerId', 'adminIds', 'memberIds',
          'createdAt', 'updatedAt', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'onlyAdminsCanSend'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'description', 'photoURL', 'ownerId', 'adminIds', 'memberIds',
          'createdAt', 'updatedAt', 'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'onlyAdminsCanSend'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.adminIds is list
        && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
        && request.resource.data.adminIds.size() == 1
        && request.resource.data.adminIds.hasOnly([request.auth.uid])
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 20
        && request.resource.data.memberIds.hasAll([request.auth.uid])
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastMessageSenderId == ''
        && request.resource.data.lastMessageAt == null
        && request.resource.data.onlyAdminsCanSend == false;

      allow update: if isGroupMember() && (
        // Owner or administrator can edit basic group information.
        (
          request.auth.uid in resource.data.adminIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'photoURL', 'onlyAdminsCanSend', 'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 50
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 180
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 2048
          && request.resource.data.onlyAdminsCanSend is bool
          && request.resource.data.updatedAt == request.time
        )
        ||
        // Only the owner can promote or demote administrators and manage removals.
        (
          request.auth.uid == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds', 'adminIds', 'updatedAt'
          ])
          && request.resource.data.memberIds is list
          && request.resource.data.adminIds is list
          && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
          && request.resource.data.adminIds.toSet().size() == request.resource.data.adminIds.size()
          && request.resource.data.memberIds.size() >= 1
          && request.resource.data.memberIds.size() <= 200
          && request.resource.data.memberIds.hasAll([resource.data.ownerId])
          && request.resource.data.memberIds.hasAll(request.resource.data.adminIds)
          && request.resource.data.adminIds.hasAll([resource.data.ownerId])
          && request.resource.data.updatedAt == request.time
        )
        ||
        // Existing administrators may add one new member, but cannot grant admin rights.
        (
          request.auth.uid in resource.data.adminIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds', 'updatedAt'
          ])
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 200
          && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.adminIds == resource.data.adminIds
          && request.resource.data.updatedAt == request.time
        )
        ||
        // A regular member may leave, but cannot remove another participant or the owner.
        (
          request.auth.uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds', 'adminIds', 'updatedAt'
          ])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.adminIds == resource.data.adminIds.removeAll([request.auth.uid])
          && request.resource.data.updatedAt == request.time
        )
        ||
        // Group members may update only the last-message preview when they send a message.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessageText', 'lastMessageSenderId', 'lastMessageAt', 'updatedAt'
          ])
          && request.resource.data.lastMessageText is string
          && request.resource.data.lastMessageText.size() <= 180
          && request.resource.data.lastMessageSenderId == request.auth.uid
          && request.resource.data.lastMessageAt == request.time
          && request.resource.data.updatedAt == request.time
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /messages/{messageId} {
        allow read: if isGroupMember();

        allow create: if isGroupMember()
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'kind', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'senderName', 'text', 'kind', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 50
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.kind in ['text', 'announcement']
          && (request.resource.data.kind == 'text' || isGroupAdmin())
          && (!get(/databases/$(database)/documents/groups/$(groupId)).data.onlyAdminsCanSend || isGroupAdmin())
          && request.resource.data.createdAt == request.time;

        allow update: if isGroupMember() && (
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000)
          ||
          (isGroupAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
            && request.resource.data.pinned is bool)
        );
        allow delete: if isGroupAdmin() || (
          isGroupMember() && resource.data.senderId == request.auth.uid
        );
      }
    }
  }
}
